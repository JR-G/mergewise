{
  "name": "mergewise",
  "version": "0.1.1",
  "description": "Refactor-focused code review tooling for pull requests.",
  "author": "JR-G",
  "license": "MIT",
  "packageManager": "bun@1.3.5",
  "engines": {
    "bun": ">=1.3.5"
  },
  "module": "index.ts",
  "type": "module",
  "private": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JR-G/mergewise.git"
  },
  "homepage": "https://github.com/JR-G/mergewise#readme",
  "bugs": {
    "url": "https://github.com/JR-G/mergewise/issues"
  },
  "bin": {
    "mergewise": "bin/mergewise.js"
  },
  "files": [
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bunx tsc -p tsconfig.build.json",
    "dev:webhook": "bun run apps/webhook-api/src/main.ts",
    "dev:worker": "bun run apps/worker/src/main.ts",
    "dev:webhook:local": "bash scripts/dev-run.sh webhook",
    "dev:worker:local": "bash scripts/dev-run.sh worker",
    "dev:stack": "bash scripts/dev-stack.sh",
    "dev:site": "bun run apps/site/server.ts",
    "quality:gates": "bash scripts/quality-gates.sh",
    "pr:validate-body": "bash scripts/validate-pr-body.sh",
    "lint": "bunx eslint .",
    "typecheck": "bunx tsc --noEmit",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:coverage:check": "bash scripts/check-coverage.sh 80",
    "eval": "bun run packages/eval/src/main.ts",
    "prepare": "git config core.hooksPath .hooks",
    "prepublishOnly": "bun run lint && bun run typecheck && bun run test"
  },
  "dependencies": {
    "picomatch": "^4.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/bun": "latest",
    "@types/picomatch": "^4.0.2",
    "eslint": "^9.39.1",
    "eslint-plugin-tsdoc": "^0.5.0",
    "lefthook": "^2.1.0",
    "openai": "^6.22.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  }
}
