      "header": "@@ -0,0 +1,43 @@",
      "lines": [
        "+interface User {",
        "+  id: string;",
        "+  name: string;",
        "+  role: string;",
        "+}",
        "+",
        "+export class UserRegistry {",
        "+  private users: User[] = [];",
        "+  private roleIndex = new Map<string, User[]>();",
        "+",
        "+  addUser(user: User): void {",
        "+    this.users.push(user);",
        "+    const group = this.roleIndex.get(user.role) ?? [];",
        "+    group.push(user);",
        "+    this.roleIndex.set(user.role, group);",
        "+  }",
        "+",
        "+  removeUser(userId: string): void {",
        "+    const index = this.users.findIndex(u => u.id === userId);",
        "+    if (index !== -1) this.users.splice(index, 1);",
        "+  }",
        "+",
        "+  getUsers(): User[] {",
        "+    return this.users;",
        "+  }",
        "+",
        "+  getRoleIndex(): Map<string, User[]> {",
        "+    return this.roleIndex;",
        "+  }",
        "+",
        "+  getAdmins(): User[] {",
        "+    return this.roleIndex.get(\"admin\") ?? [];",
        "+  }",
        "+",
        "+  getUserCount(): number {",
        "+    return this.users.length;",
        "+  }",
        "+",
        "+  clear(): void {",
        "+    this.users = [];",
        "+    this.roleIndex.clear();",
        "+  }",
        "+}"
      ]
    }
  ]
}
