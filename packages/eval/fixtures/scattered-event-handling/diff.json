      "lines": [
        "+import type { EventEmitter } from \"node:events\";",
        "+import type { Server } from \"node:http\";",
        "+",
        "+interface AppConfig {",
        "+  port: number;",
        "+  host: string;",
        "+  dbUrl: string;",
        "+}",
        "+",
        "+function setupServer(server: Server, emitter: EventEmitter, config: AppConfig): void {",
        "+  const db = connectDatabase(config.dbUrl);",
        "+",
        "+  emitter.on(\"connection\", (socket) => {",
        "+    socket.setKeepAlive(true);",
        "+    activeSockets.add(socket);",
        "+  });",
        "+",
        "+  const cache = createCache({ ttl: 300 });",
        "+  loadRoutes(server, db, cache);",
        "+",
        "+  emitter.on(\"error\", (err: Error) => {",
        "+    logger.error(\"server error\", { error: err.message });",
        "+    metrics.increment(\"server.errors\");",
        "+  });",
        "+",
        "+  const healthCheck = startHealthCheck(db, cache);",
        "+",
        "+  emitter.on(\"close\", () => {",
        "+    for (const socket of activeSockets) {",
        "+      socket.destroy();",
        "+    }",
        "+    activeSockets.clear();",
        "+  });",
        "+",
        "+  registerMiddleware(server, config);",
        "+",
        "+  emitter.on(\"upgrade\", (req, socket, head) => {",
        "+    wsServer.handleUpgrade(req, socket, head, (ws) => {",
        "+      wsServer.emit(\"connection\", ws, req);",
        "+    });",
        "+  });",
        "+",
        "+  emitter.on(\"request\", (req, res) => {",
        "+    requestLogger.log(req.method, req.url);",
        "+    metrics.increment(\"server.requests\");",
        "+  });",
        "+",
        "+  server.listen(config.port, config.host);",
        "+}"
      ]
    }
  ]
}
