[
  {
    "description": "Flags inconsistent absent value representation",
    "matchLineRange": [1, 6],
    "matchRecommendationContainsAny": ["undefined", "optional", "consistent", "null"],
    "required": true
  },
  {
    "description": "Flags overly wide generic constraint",
    "matchLineRange": [6, 10],
    "matchRecommendationContainsAny": ["specific", "narrow", "constrain"],
    "required": false
  },
  {
    "description": "Flags deeply nested callbacks",
    "matchLineRange": [4, 20],
    "matchRecommendationContainsAny": ["await", "async", "Promise", "flatten"],
    "required": true
  }
]
