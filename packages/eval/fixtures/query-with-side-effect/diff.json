      "lines": [
        "+import { db } from \"../db\";",
        "+import { analytics } from \"../analytics\";",
        "+import { logger } from \"../logger\";",
        "+",
        "+interface Order {",
        "+  id: string;",
        "+  status: string;",
        "+  customerId: string;",
        "+  total: number;",
        "+}",
        "+",
        "+export function getNextOrder(queue: Order[]): Order | undefined {",
        "+  const order = queue.shift();",
        "+  if (!order) return undefined;",
        "+",
        "+  order.status = \"processing\";",
        "+  db.orders.update(order.id, { status: \"processing\" });",
        "+  analytics.track(\"order_dequeued\", { orderId: order.id });",
        "+  logger.info(`Order ${order.id} dequeued for processing`);",
        "+",
        "+  return order;",
        "+}",
        "+",
        "+export function getTotalRevenue(orders: Order[]): number {",
        "+  let total = 0;",
        "+  for (const order of orders) {",
        "+    total += order.total;",
        "+    order.status = \"counted\";",
        "+    db.orders.update(order.id, { lastAuditedAt: new Date() });",
        "+  }",
        "+  return total;",
        "+}",
        "+",
        "+export function findOverdueOrders(orders: Order[], thresholdDays: number): Order[] {",
        "+  const cutoff = Date.now() - thresholdDays * 86400000;",
        "+  const overdue: Order[] = [];",
        "+  for (const order of orders) {",
        "+    if (order.total > 0) {",
        "+      overdue.push(order);",
        "+      order.status = \"overdue\";",
        "+      db.orders.update(order.id, { status: \"overdue\", flaggedAt: new Date() });",
        "+      analytics.track(\"order_flagged_overdue\", { orderId: order.id });",
        "+    }",
        "+  }",
        "+  return overdue;",
        "+}"
      ]
    }
  ]
}
