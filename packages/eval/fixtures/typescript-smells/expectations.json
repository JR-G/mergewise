[
  {
    "description": "Flags unsafe as type assertions instead of type guards",
    "matchLineRange": [7, 30],
    "matchRecommendationContainsAny": ["type guard", "assertion", "validat", "runtime", "unsafe", "narrow", "check", "cast", "as "],
    "required": true
  },
  {
    "description": "Flags enum usage — prefer literal union types",
    "matchLineRange": [1, 6],
    "matchRecommendationContainsAny": ["union", "literal", "enum"],
    "required": false
  },
  {
    "description": "Flags too many positional parameters — use options object",
    "matchLineRange": [13, 21],
    "matchRecommendationContainsAny": ["object", "parameter", "options"],
    "required": false
  }
]
