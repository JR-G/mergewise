      "lines": [
        "+interface User {",
        "+  readonly id: string;",
        "+  readonly name: string;",
        "+  readonly email: string;",
        "+  readonly role: \"admin\" | \"editor\" | \"viewer\";",
        "+  readonly createdAt: Date;",
        "+}",
        "+",
        "+interface Product {",
        "+  readonly id: string;",
        "+  readonly title: string;",
        "+  readonly price: number;",
        "+  readonly stock: number;",
        "+}",
        "+",
        "+let nextId = 1;",
        "+",
        "+export function createTestUser(overrides: Partial<User> = {}): User {",
        "+  const id = String(nextId++);",
        "+  return {",
        "+    id,",
        "+    name: `User ${id}`,",
        "+    email: `user${id}@test.example`,",
        "+    role: \"viewer\",",
        "+    createdAt: new Date(\"2024-01-01\"),",
        "+    ...overrides,",
        "+  };",
        "+}",
        "+",
        "+export function createTestProduct(overrides: Partial<Product> = {}): Product {",
        "+  const id = String(nextId++);",
        "+  return {",
        "+    id,",
        "+    title: `Product ${id}`,",
        "+    price: 9.99,",
        "+    stock: 10,",
        "+    ...overrides,",
        "+  };",
        "+}",
        "+",
        "+export function createTestUsers(count: number, overrides: Partial<User> = {}): User[] {",
        "+  return Array.from({ length: count }, () => createTestUser(overrides));",
        "+}",
        "+",
        "+export function createAdminUser(overrides: Partial<User> = {}): User {",
        "+  return createTestUser({ role: \"admin\", ...overrides });",
        "+}"
      ]
    }
