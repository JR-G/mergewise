{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": false,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun"],
    "baseUrl": ".",
    "paths": {
      "@mergewise/github-client": ["packages/github-client/src/index.ts"],
      "@mergewise/config-loader": ["packages/config-loader/src/index.ts"],
      "@mergewise/job-store": ["packages/job-store/src/index.ts"],
      "@mergewise/worker": ["apps/worker/src/index.ts"],
      "@mergewise/rule-engine": ["packages/rule-engine/src/index.ts"],
      "@mergewise/shared-types": ["packages/shared-types/src/index.ts"],
      "@mergewise/webhook-api": ["apps/webhook-api/src/index.ts"],
      "@mergewise/llm-reviewer": ["packages/llm-reviewer/src/index.ts"],
      "@mergewise/eval": ["packages/eval/src/main.ts"],
      "@mergewise/feedback-store": ["packages/feedback-store/src/index.ts"]
    },

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true
  },
  "exclude": ["dist", "node_modules", ".mergewise-runtime", "packages/eval/fixtures"]
}
